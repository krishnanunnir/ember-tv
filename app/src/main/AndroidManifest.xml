<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- HDMI inputs, where the TV has them. -->
    <uses-feature android:name="android.software.live_tv" android:required="false" />

    <!-- Uninstall from the long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Only the apps a launcher shows, not every package on the TV. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon packs (Settings → Icon pack). -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <!-- The file picker for backup and the own background, to tell when the TV has none. -->
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.CREATE_DOCUMENT" /><data android:mimeType="*/*" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Ember">

        <activity
            android:name=".Home"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".EmberSettings" android:exported="false" android:label="@string/settings_title" />

        <!-- Google TV's own home outranks any other HOME app, so Home always opens it first. This service sees that
             window appear and brings Ember forward instead. The user switches it on in Accessibility settings. -->
        <service
            android:name=".HomeWatcher"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_watcher" />
        </service>
    </application>
</manifest>
